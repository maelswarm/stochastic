<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>
<main class="auth-page marketing-page">
  <h1>Forgot password</h1>
  <% if (sent) { %>
    <p>If an account for <strong><%= email %></strong> exists, we've sent a password reset link. It expires in 1 hour.</p>
    <p class="auth-alt-link"><a href="/login">Back to log in</a></p>
  <% } else { %>
    <% if (typeof errors !== 'undefined' && errors.length) { %>
      <ul class="form-errors">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>
    <form action="/forgot-password" method="POST" class="auth-form">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" required autofocus>

      <% if (turnstileSiteKey) { %>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="auto"></div>
      <% } %>

      <button type="submit">Send reset link</button>
    </form>
    <p class="auth-alt-link"><a href="/login">Back to log in</a></p>
  <% } %>
</main>
<%- include('../partials/footer') %>
</body>
</html>
