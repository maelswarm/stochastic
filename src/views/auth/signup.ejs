<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>
<main class="auth-page marketing-page">
  <h1>Create your account</h1>
  <%- include('../partials/flash') %>
  <% if (errors && errors.length) { %>
    <ul class="form-errors">
      <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
    </ul>
  <% } %>
  <form action="/signup" method="POST" class="auth-form">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= email %>" required autofocus>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" minlength="10" required>
    <p class="field-hint">At least 10 characters.</p>

    <% if (turnstileSiteKey) { %>
      <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="auto"></div>
    <% } %>

    <button type="submit">Sign up</button>
  </form>
  <p class="auth-alt-link">Already have an account? <a href="/login">Log in</a></p>
</main>
<%- include('../partials/footer') %>
</body>
</html>
