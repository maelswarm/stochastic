<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>
<main class="auth-page marketing-page">
  <h1>Reset password</h1>
  <% if (errors && errors.length) { %>
    <ul class="form-errors">
      <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
    </ul>
  <% } %>
  <form action="/reset-password" method="POST" class="auth-form">
    <input type="hidden" name="token" value="<%= token %>">
    <label for="password">New password</label>
    <input type="password" id="password" name="password" minlength="10" required autofocus>
    <p class="field-hint">At least 10 characters.</p>
    <button type="submit">Reset password</button>
  </form>
</main>
<%- include('../partials/footer') %>
</body>
</html>
