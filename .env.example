# --- required -----------------------------------------------------------
DATABASE_URL=postgres://stochastic:stochastic@localhost:5432/stochastic
SESSION_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:3000
# 32-byte key (base64 or hex) used to encrypt BYOK provider keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=

# --- dev server (legacy single-port mode) --------------------------------
PORT=3000

# --- email (Resend) -------------------------------------------------------
# Left blank in dev: emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=stochastic <alerts@yourdomain.com>

# --- bot protection (Cloudflare Turnstile) --------------------------------
# Left blank in dev: CAPTCHA verification is skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- market data -----------------------------------------------------------
# Per-user Alpaca keys are entered in Settings (BYOK) and stored encrypted
# in the database -- these are optional operator-level fallback keys for
# local dev/demo only; leave blank in production. Not used by
# scripts/seed-instruments.js, which borrows an already-connected user's
# own key instead (see that file).
ALPACA_FALLBACK_KEY_ID=
ALPACA_FALLBACK_SECRET=

POLL_INTERVAL_MS=1000
EMAIL_DAILY_CAP=50
